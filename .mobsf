# MobSF ei nae Gradlessa maariteltya targetSdk-arvoa lahdemanifestista, joten
# StrandHogg 2.0 -saanto on tessa projektissa false positive.
# BackupDatabaseValidator kayttaa vain kiinteita PRAGMA-kyselyita ja sidottuja
# Room-metadatan hakuja restore-kandidaatin lukemiseen.
ignore-paths:
  - .deepsec
  - .git
  - .gradle
  - .kotlin
  - .sonar
  - .tmp
  - android
  - build
  - caches
  - daemon
  - kotlin-profile
  - native
  - node_modules
  - notifications
  - reports

severity-filter:
  - WARNING
  - ERROR
